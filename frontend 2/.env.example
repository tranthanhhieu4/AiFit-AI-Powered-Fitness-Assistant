# Base URL of the AIFit.Api backend (Architecture Design 3.2)
VITE_API_BASE_URL=/api

# Where the MediaPipe Pose Landmarker task file is served from.
# Download pose_landmarker_lite.task from Google and place it in
# frontend/public/models/, or point this at the official CDN.
VITE_POSE_MODEL_URL=/models/pose_landmarker_lite.task
